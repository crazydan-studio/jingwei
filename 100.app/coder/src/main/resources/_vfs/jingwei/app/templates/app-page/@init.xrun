<?xml version="1.0" encoding="UTF-8" ?>

<c:unit xmlns:c="c" xmlns:gen="gen" xmlns:xpl="xpl">

    <c:script><![CDATA[
        let uiModel = codeGenModel;
    ]]></c:script>

    <gen:DefineLoop xpl:lib="/nop/codegen/xlib/gen.xlib" xpl:slotScope="builder">
        <c:script><![CDATA[
            builder.defineGlobalVar("uiModel", uiModel);
            builder.defineGlobalVar("page", uiModel.page);
            builder.defineGlobalVar('appCode', codeGenConfig.code);

            builder.defineLoopVar("component", "uiModel", model => model.components);
        ]]></c:script>
    </gen:DefineLoop>
</c:unit>
