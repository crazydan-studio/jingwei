<!-- [业务模型设计结构]
-->
<model-design xmlns:x="/nop/schema/xdsl.xdef" xmlns:xdef="/nop/schema/xdef.xdef"
              xmlns:db="db" xmlns:orm="orm" xmlns:ref="ref"
              x:schema="/nop/schema/xdef.xdef"
>

    <dicts xdef:body-type="list" xdef:key-attr="name">
        <dict name="!kebab-case" displayName="string">
            <description>string</description>

            <options xdef:body-type="list" xdef:key-attr="value">
                <option value="!digits" code="!macro-case" displayName="string">
                    <description>string</description>
                </option>
            </options>
        </dict>
    </dicts>

    <entities xdef:body-type="list" xdef:key-attr="name">
        <entity name="!pascal-case" displayName="string"
                deprecated="boolean" db:estimatedRowCount="int"
                orm:createrProp="attr-name" orm:createTimeProp="attr-name"
                orm:updaterProp="attr-name" orm:updateTimeProp="attr-name"
                orm:deleteFlagProp="attr-name"
        >
            <description>string</description>

            <orm:unique-keys xdef:body-type="list" xdef:key-attr="name">
                <key name="!snake-case">entity-attr-csv-string</key>
            </orm:unique-keys>

            <attrs xdef:body-type="list" xdef:key-attr="name">
                <attr name="!camel-case" displayName="string"
                      propId="!int" mandatory="!boolean=false" orm:primary="!boolean=false"
                      virtual="!boolean=false" published="!boolean=true"
                      insertable="!boolean=false" updatable="!boolean=false"
                      queryable="!boolean=false" sortable="!boolean=false"
                      maskPattern="string" datePattern="string"
                      internal="!boolean=false" deprecated="boolean"

                      dict="dict-name" domain="!domain-name"
                      precision="int" scale="int"
                      defaultValue="any"
                      minValue="double" maxValue="double"
                      minLength="int" maxLength="int"
                      minFileSize="file-size" maxFileSize="file-size"
                      allowedFileTypes="mime-type-csv-string"

                      mapTo="attr-path"

                      ref:target="ref-entity-name" ref:type="ref-type"
                      ref:targetAttr="ref-entity-attr-name" ref:cascadeDelete="boolean"
                >
                    <description>string</description>

                    <computed>xpl-fn</computed>
                </attr>
            </attrs>
        </entity>
    </entities>

    <actions xdef:body-type="list" xdef:key-attr="name">
        <action name="!entity-name__action-name" displayName="string"
                type="!action-type"
        >
            <description>string</description>

            <arg xdef:unique-attr="name"
                 name="!var-name" displayName="string"
                 mandatory="!boolean=false"
                 type="!entity-name-or-data-type"
            >
                <description>string</description>
            </arg>

            <return type="data-type"/>

            <source>xpl</source>
        </action>
    </actions>
</model-design>
