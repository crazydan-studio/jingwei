<lib xmlns:x="/nop/schema/xdsl.xdef" xmlns:c="c" xmlns:thisLib="thisLib"
     x:schema="/nop/schema/xlib.xdef"
>

    <tags>
        <UiDesignToUiModel>
            <description>
                将 xxx.ai-ui-design.xml 转换为 AiUiModel 对象，
                以便于后续生成 UI 代码
            </description>

            <attr name="codeGenConfig" implicit="true"/>
            <attr name="node" type="io.nop.core.lang.xml.XNode"/>

            <source>
                <c:script><![CDATA[
                    import io.crazydan.jingwei.app.coder.model.AiUiModel;

                    const uiModel = new AiUiModel();

                    for (let childNode of node.getChildren()) {
                        if (childNode.tagName == 'page') {
                            uiModel.page = xpl `<thisLib:_GenUiModelPage node="${childNode}"/>`;
                        } else if (childNode.tagName == 'components') {
                            uiModel.components = xpl `<thisLib:_GenUiModelComponents node="${childNode}"/>`;
                        }
                    }
                    return uiModel;
                ]]></c:script>
            </source>
        </UiDesignToUiModel>

        <_GenUiModelPage>
            <attr name="codeGenConfig" implicit="true"/>
            <attr name="node" type="io.nop.core.lang.xml.XNode"/>

            <source>
                <c:script><![CDATA[
                    import io.crazydan.jingwei.app.coder.model.AiUiModel.Page;

                    const page = new Page();
                    page.title = node.attrText('title');
                    page.body = $String.trimToNull(node.contentText());

                    return page;
                ]]></c:script>
            </source>
        </_GenUiModelPage>

        <_GenUiModelComponents>
            <attr name="codeGenConfig" implicit="true"/>
            <attr name="node" type="io.nop.core.lang.xml.XNode"/>

            <source>
                <c:script><![CDATA[
                    const components = [];

                    for (let childNode of node.getChildren()) {
                        const component = xpl `<thisLib:_GenUiModelComponent node="${childNode}"/>`;
                        components.add(component);
                    }
                    return components;
                ]]></c:script>
            </source>
        </_GenUiModelComponents>
        <_GenUiModelComponent>
            <attr name="codeGenConfig" implicit="true"/>
            <attr name="node" type="io.nop.core.lang.xml.XNode"/>

            <source>
                <c:script><![CDATA[
                    import io.crazydan.jingwei.app.coder.model.AiUiModel.Component;

                    const component = new Component();
                    component.name = node.attrText('name');
                    component.body = $String.trimToNull(node.contentText());

                    return component;
                ]]></c:script>
            </source>
        </_GenUiModelComponent>
    </tags>
</lib>
