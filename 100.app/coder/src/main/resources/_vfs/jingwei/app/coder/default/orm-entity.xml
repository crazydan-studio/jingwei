<!-- Note: 统一采用动态模型 DynamicOrmEntity，以避免创建实体 class -->
<entity xmlns:x="/nop/schema/xdsl.xdef" x:schema="/nop/schema/orm/entity.xdef"
        className="io.nop.orm.support.DynamicOrmEntity" registerShortName="true"
        useLogicalDelete="true" deleteFlagProp="deleted"
        createrProp="createdBy" createTimeProp="createdAt"
        updaterProp="updatedBy" updateTimeProp="updatedAt"
>

    <columns>
        <column name="id" code="col_id" propId="1"
                domain="uuid" displayName="ID"
                primary="true" mandatory="true"
                insertable="true" updatable="false"
                tagSet="seq"
        />

        <!-- Note: propId 最大值由 OrmModelConstants#MAX_PROP_ID 确定 -->
        <column name="createdBy" code="col_created_by" propId="2"
                domain="userFlag" displayName="创建者"
                insertable="true" updatable="false"
        />
        <column name="updatedBy" code="col_updated_by" propId="3"
                domain="userFlag" displayName="更新者"
                insertable="true" updatable="true"
        />
        <column name="createdAt" code="col_created_at" propId="4"
                domain="datetime" displayName="创建时间"
                insertable="true" updatable="false"
        />
        <column name="updatedAt" code="col_updated_at" propId="5"
                domain="datetime" displayName="更新时间"
                insertable="true" updatable="true"
        />

        <column name="deleted" code="col_deleted" propId="6"
                domain="deleteFlag" displayName="是否已删除"
                insertable="true" updatable="true"
        />
    </columns>
</entity>
