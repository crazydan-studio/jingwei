<?xml version="1.0" encoding="UTF-8" ?>

<c:unit xmlns:c="c" xmlns:gen="gen" xmlns:xpl="xpl">

    <c:script><![CDATA[
        let ormModel = codeGenModel;

        ormModel['ext:appName'] = 'jingwei-app';
        ormModel['ext:basePackageName'] = 'io.crazydan.jingwei.app';
    ]]></c:script>

    <gen:DefineLoopForOrm xpl:lib="/nop/codegen/xlib/gen.xlib" xpl:slotScope="builder">
        <c:script><![CDATA[
            builder.defineGlobalVar('appCode', codeGenConfig.code);
        ]]></c:script>
    </gen:DefineLoopForOrm>
</c:unit>
