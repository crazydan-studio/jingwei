<lib xmlns:x="/nop/schema/xdsl.xdef" xmlns:c="c" xmlns:xpl="xpl" xmlns:thisLib="thisLib"
     x:schema="/nop/schema/xlib.xdef"
>

    <tags>
        <ModelDesignToOrmModel outputMode="none">
            <description>
                将 xxx.ai-model-design.xml 转换为 OrmModel 对象，
                以便于后续生成 xxx.orm.xml、xxx.xmeta、xxx.xbiz 等 DSL
            </description>

            <attr name="codeGenConfig" implicit="true"/>
            <attr name="node" type="io.nop.core.lang.xml.XNode"/>

            <source>
                <c:script><![CDATA[
                    import io.nop.orm.model.OrmModelConstants;
                    import io.crazydan.jingwei.app.coder.model.AiOrmModel;
                    import io.nop.xlang.xdsl.DslModelHelper;
                    import io.crazydan.jingwei.app.coder.AppCoderConstants;

                    // 等价于构造 /nop/schema/orm/orm.xdef
                    const ormModel = new AiOrmModel();
                    ormModel['ext:registerShortName'] = true;
                    ormModel[OrmModelConstants.EXT_ALLOW_ID_AS_COL_NAME] = true;

                    const defaultOrmModel = //
                        DslModelHelper.loadDslModelFromPath(AppCoderConstants.ORM_DEFAULT_DOMAINS_PATH);
                    ormModel.domains = defaultOrmModel.domains;

                    $scope.setLocalValue(location(), 'ormModel', ormModel);
                    for (let childNode of node.getChildren()) {
                        if (childNode.tagName == 'dicts') {
                            ormModel.dicts = xpl `<thisLib:_GenOrmModelDicts node="${childNode}"/>`;
                        } //
                        else if (childNode.tagName == 'entities') {
                            ormModel.entities = xpl `<thisLib:_GenOrmModelEntities node="${childNode}"/>`;
                        }
                    }
                    return ormModel;
                ]]></c:script>
            </source>
        </ModelDesignToOrmModel>

        <_GenOrmModelDicts>
            <attr name="codeGenConfig" implicit="true"/>
            <attr name="node" type="io.nop.core.lang.xml.XNode"/>

            <source>
                <c:script><![CDATA[
                    const dicts = [];

                    for (let childNode of node.getChildren()) {
                        const dict = xpl `<thisLib:_GenOrmModelDict node="${childNode}"/>`;
                        dicts.add(dict);
                    }
                    return dicts;
                ]]></c:script>
            </source>
        </_GenOrmModelDicts>
        <_GenOrmModelDict>
            <attr name="codeGenConfig" implicit="true"/>
            <attr name="node" type="io.nop.core.lang.xml.XNode"/>

            <source>
                <c:script><![CDATA[
                    import io.nop.api.core.beans.DictBean;

                    // 等价于构造 /nop/schema/orm/dict.xdef
                    const dict = new DictBean();
                    dict.name = codeGenConfig.bizDomain + '/' + node.attrText('name');
                    dict.label = node.attrText('displayName');
                    dict.valueType = 'string';

                    for (let childNode of node.getChildren()) {
                        if (childNode.tagName == 'description') {
                            dict.description = $String.trimToNull(childNode.contentText());
                        } //
                        else if (childNode.tagName == 'options') {
                            dict.options = xpl `<thisLib:_GenOrmModelDictOptions node="${childNode}"/>`;
                        }
                    }
                    return dict;
                ]]></c:script>
            </source>
        </_GenOrmModelDict>

        <_GenOrmModelDictOptions>
            <attr name="codeGenConfig" implicit="true"/>
            <attr name="node" type="io.nop.core.lang.xml.XNode"/>

            <source>
                <c:script><![CDATA[
                    const options = [];

                    for (let childNode of node.getChildren()) {
                        const option = xpl `<thisLib:_GenOrmModelDictOption node="${childNode}"/>`;
                        options.add(option);
                    }
                    return options;
                ]]></c:script>
            </source>
        </_GenOrmModelDictOptions>
        <_GenOrmModelDictOption>
            <attr name="codeGenConfig" implicit="true"/>
            <attr name="node" type="io.nop.core.lang.xml.XNode"/>

            <source>
                <c:script><![CDATA[
                    import io.nop.api.core.beans.DictOptionBean;

                    const option = new DictOptionBean();
                    option.value = node.attrText('value');
                    option.code = node.attrText('code');
                    option.label = node.attrText('displayName');
                    option.description = $String.trimToNull(node.childContentText('description'));

                    return option;
                ]]></c:script>
            </source>
        </_GenOrmModelDictOption>

        <_GenOrmModelEntities>
            <attr name="codeGenConfig" implicit="true"/>
            <attr name="node" type="io.nop.core.lang.xml.XNode"/>

            <source>
                <c:script><![CDATA[
                    const entities = [];

                    for (let childNode of node.getChildren()) {
                        const entity = xpl `<thisLib:_GenOrmModelEntity node="${childNode}"/>`;
                        entities.add(entity);
                    }
                    return entities;
                ]]></c:script>
            </source>
        </_GenOrmModelEntities>
        <_GenOrmModelEntity>
            <attr name="codeGenConfig" implicit="true"/>
            <attr name="node" type="io.nop.core.lang.xml.XNode"/>

            <source>
                <c:script><![CDATA[
                    import io.nop.commons.util.ClassHelper;
                    import io.nop.orm.model.OrmEntityModel;
                    import io.nop.orm.support.DynamicOrmEntity;

                    // 等价于构造 /nop/schema/orm/entity.xdef
                    const entity = new OrmEntityModel();
                    entity.name = node.attrText('name');

                    entity.tableName = codeGenConfig.genTableName(entity.name);
                    //entity.querySpace = codeGenConfig.dbQuerySpace;
                    entity.displayName = node.attrText('displayName');
                    entity.tagSet = [];

                    entity.notGenCode = node.attrBoolean('deprecated');
                    entity['db:estimatedRowCount'] = node.attrInt('db:estimatedRowCount');

                    // Note: 统一采用动态模型，以避免创建实体 class
                    entity.className = ClassHelper.getCanonicalClassName(DynamicOrmEntity);
                    entity.registerShortName = true;
                    entity.createrProp = node.attrText('orm:createrProp');
                    entity.createTimeProp = node.attrText('orm:createTimeProp');
                    entity.updaterProp = node.attrText('orm:updaterProp');
                    entity.updateTimeProp = node.attrText('orm:updateTimeProp');
                    entity.deleteFlagProp = node.attrText('orm:deleteFlagProp');
                    entity.useLogicalDelete = entity.deleteFlagProp == true;

                    let uniqueKeysNode = null;
                    for (let childNode of node.getChildren()) {
                        if (childNode.tagName == 'description') {
                            entity.comment = $String.trimToNull(childNode.contentText());
                        } //
                        else if (childNode.tagName == 'orm:unique-keys') {
                            uniqueKeysNode = childNode;
                        } //
                        else if (childNode.tagName == 'attrs') {
                            const result = xpl `<thisLib:_GenOrmModelEntityColumnsAndRelations node="${childNode}"/>`;
                            entity.columns = result.columns;
                            entity.relations = result.relations;
                        }
                    }

                    if (uniqueKeysNode != null) {
                        entity.uniqueKeys = xpl `<thisLib:_GenOrmModelEntityUniqueKeys
                                                    entity="${entity}" node="${uniqueKeysNode}"/>`;
                    }

                    return entity;
                ]]></c:script>
            </source>
        </_GenOrmModelEntity>

        <_GenOrmModelEntityColumnsAndRelations>
            <attr name="codeGenConfig" implicit="true"/>
            <attr name="node" type="io.nop.core.lang.xml.XNode"/>

            <source>
                <c:script><![CDATA[
                    const columns = [];
                    const relations = [];

                    for (let childNode of node.getChildren()) {
                        const column = xpl `<thisLib:_GenOrmModelEntityColumn node="${childNode}"/>`;
                        const relation = xpl `<thisLib:_GenOrmModelEntityRelation node="${childNode}"/>`;

                        if (column != null) {
                            columns.add(column);
                        }
                        if (relation != null) {
                            relations.add(relation);
                        }
                    }
                    return {columns, relations};
                ]]></c:script>
            </source>
        </_GenOrmModelEntityColumnsAndRelations>

        <_GenOrmModelEntityColumn>
            <attr name="codeGenConfig" implicit="true"/>
            <attr name="node" type="io.nop.core.lang.xml.XNode"/>

            <source>
                <c:script><![CDATA[
                    import io.crazydan.jingwei.app.coder.AppCoderConstants;
                    import io.nop.orm.model.OrmModelConstants;
                    import io.nop.orm.model.OrmColumnModel;

                    let name = node.attrText('name');
                    const refType = node.attrText('ref:type');
                    if (refType != null) {
                        if (refType != AppCoderConstants.ORM_ONE_TO_ONE) {
                            return null;
                        } else {
                            name = name + 'Id';
                        }
                    }

                    const column = new OrmColumnModel();
                    column.name = name;
                    // Note: propId 最大值由 OrmModelConstants#MAX_PROP_ID 确定
                    column.propId = node.attrInt('propId');
                    column.code = 'col_' + $String.camelCaseToUnderscore(column.name, true);
                    column.displayName = node.attrText('displayName');
                    column.mandatory = node.attrBoolean('mandatory');
                    column.insertable = node.attrBoolean('insertable');
                    column.updatable = node.attrBoolean('updatable');
                    column.defaultValue = node.attrText('defaultValue');
                    column.comment = $String.trimToNull(node.childContentText('description'));
                    column.tagSet = [];

                    if (node.attrBoolean('orm:primary')) {
                        column.primary = true;
                        column.tagSet.add('seq');
                    }

                    const deprecated = node.attrBoolean('deprecated');
                    if (deprecated) {
                        column.tagSet.add('del');
                    }
                    const virtual = node.attrBoolean('virtual');
                    column.notGenCode = deprecated || virtual;

                    const dict = node.attrText('dict');
                    if (!$String.isBlank(dict)) {
                        column[OrmModelConstants.EXT_DICT] = codeGenConfig.bizDomain + '/' + dict;
                    }

                    column['meta:maskPattern'] = node.attrText('maskPattern');
                    column['meta:datePattern'] = node.attrText('datePattern');
                    column['meta:minValue'] = node.attrDouble('minValue');
                    column['meta:maxValue'] = node.attrDouble('maxValue');
                    column['meta:minLength'] = node.attrInt('minLength');
                    column['meta:maxLength'] = node.attrInt('maxLength');
                    column['meta:allowedFileTypes'] = node.attrText('allowedFileTypes');
                    if (virtual) {
                        column['meta:computed'] = node.childContentText('computed');
                    }

                    ['minFileSize', 'maxFileSize'].forEach(name => {
                        const val = node.attrText(name);
                        column['meta:' + name] = !$String.isBlank(val) ? $String.parseSize(val) : null;
                    });

                    xpl `<thisLib:_ProcessOrmModelEntityColumn
                            column="${column}" node="${node}"/>`;

                    return column;
                ]]></c:script>
            </source>
        </_GenOrmModelEntityColumn>
        <_ProcessOrmModelEntityColumn>
            <attr name="codeGenConfig" implicit="true"/>
            <attr name="column" type="io.nop.orm.model.OrmColumnModel"/>
            <attr name="node" type="io.nop.core.lang.xml.XNode"/>

            <source>
                <c:script><![CDATA[
                    import io.nop.commons.type.StdSqlType;

                    const ormModel = $scope.getValue('ormModel');
                    const stdDomain = node.attrText('domain');
                    const stdSqlTypes = {
                        fileList: StdSqlType.VARCHAR,
                        string: StdSqlType.VARCHAR,
                        long: StdSqlType.BIGINT,
                        int: StdSqlType.INTEGER,
                        double: StdSqlType.DOUBLE,
                        float: StdSqlType.FLOAT,
                        boolean: StdSqlType.BOOLEAN,
                    };
                    const domains = {
                        entityRef: 'uuid',
                        date: 'datetime', xml: 'text',
                        html: 'text', markdown: 'text',
                    };
                    const domain = //
                        ormModel.hasDomain(stdDomain)
                        ? stdDomain : domains[stdDomain];

                    if (domain) {
                        column.domain = domain;
                    } else {
                        column.stdDomain = stdDomain;
                        column.stdSqlType = stdSqlTypes[stdDomain];
                        column.precision = node.attrInt('precision', node.attrInt('maxLength'));
                        column.scale = node.attrInt('scale');
                    }

                    if (node.attrBoolean('internal')) {
                        column['ui:show'] = 'X';
                    }
                    if (!node.attrBoolean('published')) {
                        column.tagSet.add('not-pub');
                    }
                    if (!node.attrBoolean('queryable')) {
                        column.tagSet.add('not-query');
                    }
                    if (!node.attrBoolean('sortable')) {
                        column.tagSet.add('not-sort');
                    }
                ]]></c:script>
            </source>
        </_ProcessOrmModelEntityColumn>

        <_GenOrmModelEntityRelation>
            <attr name="codeGenConfig" implicit="true"/>
            <attr name="node" type="io.nop.core.lang.xml.XNode"/>

            <source>
                <c:script><![CDATA[
                    import io.crazydan.jingwei.app.coder.AppCoderConstants;
                    import io.nop.orm.model.OrmToOneReferenceModel;
                    import io.nop.orm.model.OrmToManyReferenceModel;
                    import io.nop.orm.model.OrmJoinOnModel;

                    const deprecated = node.attrBoolean('deprecated');
                    if (deprecated) {
                        return null;
                    }

                    const name = node.attrText('name');
                    const type = node.attrText('ref:type');
                    const target = node.attrText('ref:target');

                    let relation = null;
                    const join = new OrmJoinOnModel();
                    if (type == AppCoderConstants.ORM_ONE_TO_ONE) {
                        relation = new OrmToOneReferenceModel();

                        relation.ignoreDepends = true; // 不检查循环依赖
                        relation.tagSet = [];

                        join.leftProp = name + 'Id';
                        join.rightProp = 'id'; // 始终指向对端的主键
                    } else if (type == AppCoderConstants.ORM_ONE_TO_MANY) {
                        relation = new OrmToManyReferenceModel();

                        relation.refPropName = node.attrText('ref:targetAttr');
                        relation.tagSet = [];

                        join.leftProp = 'id'; // 始终从源端的主键出发
                        join.rightProp = relation.refPropName + 'Id';

                        if (node.attrBoolean('ref:cascadeDelete')) {
                            relation.cascadeDelete = true;
                            relation.tagSet.add('cascade-delete');
                        }
                        if (node.attrBoolean('insertable')) {
                            relation.tagSet.add('insertable');
                        }
                        if (node.attrBoolean('updatable')) {
                            relation.tagSet.add('updatable');
                        }
                    } else {
                        return null;
                    }
                    relation.setJoin([join]);

                    relation.name = name;
                    relation.displayName = node.attrText('displayName');
                    relation.refEntityName = target;

                    if (!node.attrBoolean('internal') && node.attrBoolean('published')) {
                        relation.tagSet.add('pub');
                    }

                    return relation;
                ]]></c:script>
            </source>
        </_GenOrmModelEntityRelation>

        <_GenOrmModelEntityUniqueKeys>
            <attr name="codeGenConfig" implicit="true"/>
            <attr name="entity" type="io.nop.orm.model.OrmEntityModel"/>
            <attr name="node" type="io.nop.core.lang.xml.XNode"/>

            <source>
                <c:script><![CDATA[
                    import io.nop.orm.model.OrmUniqueKeyModel;

                    const uniqueKeys = [];
                    for (let childNode of node.getChildren()) {
                        const uk = new OrmUniqueKeyModel();
                        const ukName = childNode.attrText('name');

                        uk.name = ukName;
                        uk.constraint = //
                            $String.startsWithIgnoreCase(ukName, 'uk_')
                            ? ukName : 'uk_' + ukName;

                        const columns = $String.parseCsvList(childNode.contentText());
                        uk.columns = columns.map((name) => {
                            const refName = name + 'Id';
                            if (entity.hasRelation(name) && entity.hasColumn(refName)) {
                                return refName;
                            }
                            return name;
                        });

                        uniqueKeys.add(uk);
                    }

                    return uniqueKeys;
                ]]></c:script>
            </source>
        </_GenOrmModelEntityUniqueKeys>
    </tags>
</lib>
