<?xml version="1.0" encoding="UTF-8" ?>

<orm xmlns:x="/nop/schema/xdsl.xdef"
     x:schema="/nop/schema/orm/orm.xdef"
>

    <domains>
        <domain name="uuid" precision="64" stdSqlType="CHAR"/>

        <domain name="xml" stdSqlType="CLOB"/>
    </domains>

    <entities>
        <entity name="App">
            <columns>
                <column name="name" code="col_name" propId="20"/>
                <column name="deleted" updatable="false"/>
            </columns>
        </entity>
        <entity name="AppVersion">
            <columns>
                <column name="createdBy" updatable="true"/>
            </columns>
        </entity>
    </entities>
</orm>
