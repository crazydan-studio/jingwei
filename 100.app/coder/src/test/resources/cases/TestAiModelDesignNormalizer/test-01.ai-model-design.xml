<?xml version="1.0" encoding="UTF-8" ?>

<model-design xmlns:x="/nop/schema/xdsl.xdef" xmlns:ext="ext"
              x:schema="/jingwei/app/schema/coder/model-design.xdef"
>
    <entities>
        <entity name="App">
            <attrs>
                <attr name="code" propId="20"/>
