<orm ext:registerShortName="true" ext:allowIdAsColName="true" x:schema="/nop/schema/orm/orm.xdef"
     xmlns:x="/nop/schema/xdsl.xdef">
    <dicts>
        <dict label="版本状态" name="app-version/status" valueType="string">
            <description>应用版本的生命周期状态：草稿或已发布</description>
            <option code="DRAFT" description="开发中的版本，可编辑，不影响运行时" label="草稿" value="010"/>
            <option code="PUBLISHED" description="不可编辑的稳定版本，可作为新草稿的基线" label="已发布" value="020"/>
        </dict>
    </dicts>
    <domains>
        <domain name="userFlag" precision="50" stdSqlType="VARCHAR"/>
        <domain name="deleteFlag" stdDomain="boolFlag" stdSqlType="BOOLEAN"/>
        <domain name="uuid" precision="32" stdSqlType="CHAR"/>
        <domain name="date" stdSqlType="BIGINT"/>
        <domain name="datetime" stdSqlType="BIGINT"/>
        <domain name="url" precision="1024" stdSqlType="VARCHAR"/>
        <domain name="file" precision="64" stdSqlType="CHAR"/>
        <domain name="fileList" stdSqlType="CLOB"/>
        <domain name="json" stdSqlType="JSON"/>
        <domain name="text" stdSqlType="CLOB"/>
    </domains>
    <entities>
        <entity className="io.nop.orm.support.DynamicOrmEntity" createTimeProp="createdAt" createrProp="createdBy"
                deleteFlagProp="deleted" displayName="应用" name="AppEntity" registerShortName="true"
                tableName="tbl_app_entity" tagSet="" updateTimeProp="updatedAt" updaterProp="updatedBy"
                db:estimatedRowCount="1000">
            <columns>
                <column code="col_id" comment="全局唯一标识，由系统自动生成" displayName="ID" domain="uuid"
                        mandatory="true" name="id"
                        precision="32" primary="true" propId="1" stdDataType="string" stdSqlType="CHAR"
                        tagSet="seq,not-sort" updatable="false" meta:allowFilterOp="eq,in" meta:insertable="false"
                        meta:updatable="false"/>
                <column code="col_created_by" comment="记录创建该应用的用户标识" displayName="创建者" domain="userFlag"
                        name="createdBy" precision="50" propId="2" stdDataType="string" stdSqlType="VARCHAR" tagSet=""
                        updatable="false" meta:allowFilterOp="eq,in" meta:insertable="false" meta:updatable="false"/>
                <column code="col_updated_by" comment="最后一次更新该应用的用户标识" displayName="更新者"
                        domain="userFlag"
                        name="updatedBy" precision="50" propId="3" stdDataType="string" stdSqlType="VARCHAR" tagSet=""
                        meta:allowFilterOp="eq,in" meta:insertable="false" meta:updatable="false"/>
                <column code="col_created_at" comment="应用创建时间，自动填充" displayName="创建时间" domain="datetime"
                        name="createdAt" propId="4" stdDataType="long" stdSqlType="BIGINT" tagSet="" updatable="false"
                        meta:allowFilterOp="eq,dateBetween,dateTimeBetween" meta:insertable="false"
                        meta:updatable="false" meta:datePattern="yyyy-MM-dd HH:mm:ss"/>
                <column code="col_updated_at" comment="应用最后一次更新时间，自动更新" displayName="更新时间"
                        domain="datetime"
                        name="updatedAt" propId="5" stdDataType="long" stdSqlType="BIGINT" tagSet=""
                        meta:allowFilterOp="eq,dateBetween,dateTimeBetween" meta:insertable="false"
                        meta:updatable="false" meta:datePattern="yyyy-MM-dd HH:mm:ss"/>
                <column code="col_deleted" comment="标记应用是否被逻辑删除，true 表示已移至回收站" defaultValue="false"
                        displayName="是否已删除"
                        domain="deleteFlag" name="deleted" propId="6" stdDataType="boolean" stdDomain="boolFlag"
                        stdSqlType="BOOLEAN" tagSet="" meta:allowFilterOp="eq,in" meta:insertable="false"
                        meta:updatable="false"/>
                <column code="col_title" comment="应用的名称，用于界面展示" displayName="标题" mandatory="true"
                        name="title"
                        precision="200" propId="7" stdDataType="string" stdDomain="string" stdSqlType="VARCHAR"
                        tagSet="" meta:allowFilterOp="eq,like,startsWith" meta:insertable="true" meta:updatable="true"
                        meta:minLength="1" meta:maxLength="200"/>
                <column code="col_code" comment="应用的全局唯一编码，由系统自动生成，不可变更" displayName="编码"
                        mandatory="true" name="code"
                        precision="32" propId="8" stdDataType="string" stdDomain="string" stdSqlType="VARCHAR" tagSet=""
                        updatable="false" meta:allowFilterOp="eq,like" meta:insertable="false" meta:updatable="false"
                        biz:codeRule="{@uuid}" meta:minLength="32" meta:maxLength="32"/>
                <column code="col_description" comment="应用的详细说明或用途" displayName="描述" domain="text"
                        name="description"
                        propId="9" stdDataType="string" stdSqlType="CLOB" tagSet="not-sort" meta:allowFilterOp="eq,like"
                        meta:insertable="true" meta:updatable="true" meta:maxLength="2000"/>
                <column code="col_active_version_id" comment="当前应用运行时使用的版本，同一时刻只有一个版本可被激活"
                        displayName="已激活版本"
                        domain="uuid" name="activeVersionId" precision="32" propId="10" stdDataType="string"
                        stdSqlType="CHAR" tagSet="" meta:allowFilterOp="eq,in" meta:insertable="true"
                        meta:updatable="true"/>
            </columns>
            <comment>用户创建的个人应用，包含应用的基本信息和版本管理</comment>
            <relations>
                <to-one displayName="已激活版本" ignoreDepends="true" name="activeVersion"
                        refEntityName="AppVersionEntity"
                        tagSet="">
                    <join>
                        <on leftProp="activeVersionId" rightProp="id"/>
                    </join>
                </to-one>
                <to-many cascadeDelete="true" displayName="版本列表" name="versions" refEntityName="AppVersionEntity"
                         refPropName="app" tagSet="cascade-delete">
                    <join>
                        <on leftProp="id" rightProp="appId"/>
                    </join>
                </to-many>
            </relations>
            <unique-keys>
                <unique-key columns="code" constraint="uk_app_code" name="uk_app_code"/>
            </unique-keys>
        </entity>
        <entity className="io.nop.orm.support.DynamicOrmEntity" createTimeProp="createdAt" createrProp="createdBy"
                displayName="应用版本" name="AppVersionEntity" registerShortName="true"
                tableName="tbl_app_version_entity"
                tagSet="" updateTimeProp="updatedAt" updaterProp="updatedBy" db:estimatedRowCount="20000">
            <columns>
                <column code="col_id" displayName="ID" domain="uuid" mandatory="true" name="id" precision="32"
                        primary="true" propId="1" stdDataType="string" stdSqlType="CHAR" tagSet="seq,not-sort"
                        updatable="false" meta:allowFilterOp="eq,in" meta:insertable="false" meta:updatable="false"/>
                <column code="col_created_by" displayName="创建者" domain="userFlag" name="createdBy" precision="50"
                        propId="2" stdDataType="string" stdSqlType="VARCHAR" tagSet="" updatable="false"
                        meta:allowFilterOp="eq,in" meta:insertable="false" meta:updatable="false"/>
                <column code="col_updated_by" displayName="更新者" domain="userFlag" name="updatedBy" precision="50"
                        propId="3" stdDataType="string" stdSqlType="VARCHAR" tagSet="" meta:allowFilterOp="eq,in"
                        meta:insertable="false" meta:updatable="false"/>
                <column code="col_created_at" displayName="创建时间" domain="datetime" name="createdAt" propId="4"
                        stdDataType="long" stdSqlType="BIGINT" tagSet="" updatable="false"
                        meta:allowFilterOp="eq,dateBetween,dateTimeBetween" meta:insertable="false"
                        meta:updatable="false" meta:datePattern="yyyy-MM-dd HH:mm:ss"/>
                <column code="col_updated_at" displayName="更新时间" domain="datetime" name="updatedAt" propId="5"
                        stdDataType="long" stdSqlType="BIGINT" tagSet=""
                        meta:allowFilterOp="eq,dateBetween,dateTimeBetween" meta:insertable="false"
                        meta:updatable="false" meta:datePattern="yyyy-MM-dd HH:mm:ss"/>
                <column code="col_app_id" comment="该版本所属的应用" displayName="所属应用" domain="uuid"
                        mandatory="true"
                        name="appId" precision="32" propId="6" stdDataType="string" stdSqlType="CHAR" tagSet=""
                        meta:allowFilterOp="eq,in" meta:insertable="true" meta:updatable="true"/>
                <column code="col_name" comment="语义化版本号，格式为 x.y.z，每段最多 3 位数字，在所属应用内唯一"
                        displayName="版本号"
                        mandatory="true" name="name" precision="11" propId="7" stdDataType="string" stdDomain="string"
                        stdSqlType="VARCHAR" tagSet="" meta:allowFilterOp="eq,like" meta:insertable="true"
                        meta:updatable="true" meta:pattern="^\d{1,3}\.\d{1,3}\.\d{1,3}$" meta:maxLength="11"/>
                <column code="col_status" comment="版本当前状态：草稿或已发布" displayName="版本状态" mandatory="true"
                        name="status"
                        propId="8" stdDataType="string" stdDomain="string" stdSqlType="VARCHAR" tagSet=""
                        ext:dict="app-version/status" meta:allowFilterOp="eq,in" meta:insertable="false"
                        meta:updatable="false"/>
                <column code="col_derived_from_id" comment="该版本所基于的已发布版本，用于追踪版本演进历史"
                        displayName="衍生来源" domain="uuid"
                        name="derivedFromId" precision="32" propId="9" stdDataType="string" stdSqlType="CHAR" tagSet=""
                        updatable="false" meta:allowFilterOp="eq,in" meta:insertable="false" meta:updatable="false"/>
            </columns>
            <comment>应用的某个特定版本，包含该版本的完整定义（需求、生成的代码等）</comment>
            <relations>
                <to-one displayName="所属应用" ignoreDepends="true" name="app" refEntityName="AppEntity" tagSet="">
                    <join>
                        <on leftProp="appId" rightProp="id"/>
                    </join>
                </to-one>
                <to-one displayName="衍生来源" ignoreDepends="true" name="derivedFrom" refEntityName="AppVersionEntity"
                        tagSet="">
                    <join>
                        <on leftProp="derivedFromId" rightProp="id"/>
                    </join>
                </to-one>
            </relations>
            <unique-keys>
                <unique-key columns="appId,name" constraint="uk_app_name" name="uk_app_name"/>
            </unique-keys>
        </entity>
    </entities>
</orm>
