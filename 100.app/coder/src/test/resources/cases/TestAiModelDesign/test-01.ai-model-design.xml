<?xml version="1.0" encoding="UTF-8" ?>

<model-design xmlns:x="/nop/schema/xdsl.xdef"
              xmlns:orm="orm" xmlns:ref="ref" xmlns:db="db"
              x:schema="/jingwei/app/coder/schema/model-design.xdef"
>
    <dicts>
        <dict name="app-version/status" displayName="版本状态">
            <description>应用版本的生命周期状态：草稿或已发布</description>
            <options>
                <option value="010" code="DRAFT" displayName="草稿">
                    <description>开发中的版本，可编辑，不影响运行时</description>
                </option>
                <option value="020" code="PUBLISHED" displayName="已发布">
                    <description>不可编辑的稳定版本，可作为新草稿的基线</description>
                </option>
            </options>
        </dict>
    </dicts>
    <entities>
        <entity name="AppEntity" displayName="应用" db:estimatedRowCount="1000" orm:createrProp="createdBy"
                orm:createTimeProp="createdAt" orm:updaterProp="updatedBy" orm:updateTimeProp="updatedAt"
                orm:deleteFlagProp="deleted">
            <description>用户创建的个人应用，包含应用的基本信息和版本管理</description>
            <orm:unique-keys>
                <key name="uk_app_code">code</key>
            </orm:unique-keys>
            <attrs>
                <attr name="id" index="1" displayName="ID" mandatory="true" domain="uuid" queryable="true"
                      sortable="false" allowFilterOp="eq,in" orm:primary="true" orm:insertable="true"
                      orm:updatable="false" published="false" insertable="false" updatable="false">
                    <description>全局唯一标识，由系统自动生成</description>
                </attr>
                <attr name="createdBy" index="2" displayName="创建者" domain="userFlag" queryable="true" sortable="true"
                      allowFilterOp="eq,in" orm:insertable="true" orm:updatable="false" insertable="false"
                      updatable="false">
                    <description>记录创建该应用的用户标识</description>
                </attr>
                <attr name="updatedBy" index="3" displayName="更新者" domain="userFlag" queryable="true" sortable="true"
                      allowFilterOp="eq,in" orm:insertable="true" orm:updatable="true" insertable="false"
                      updatable="false">
                    <description>最后一次更新该应用的用户标识</description>
                </attr>
                <attr name="createdAt" index="4" displayName="创建时间" domain="datetime" queryable="true"
                      sortable="true"
                      allowFilterOp="eq,dateBetween,dateTimeBetween" orm:insertable="true" orm:updatable="false"
                      insertable="false" updatable="false" datePattern="yyyy-MM-dd HH:mm:ss">
                    <description>应用创建时间，自动填充</description>
                </attr>
                <attr name="updatedAt" index="5" displayName="更新时间" domain="datetime" queryable="true"
                      sortable="true"
                      allowFilterOp="eq,dateBetween,dateTimeBetween" orm:insertable="true" orm:updatable="true"
                      insertable="false" updatable="false" datePattern="yyyy-MM-dd HH:mm:ss">
                    <description>应用最后一次更新时间，自动更新</description>
                </attr>
                <attr name="deleted" index="6" displayName="是否已删除" domain="deleteFlag" queryable="true"
                      sortable="true"
                      allowFilterOp="eq,in" orm:insertable="true" orm:updatable="true" insertable="false"
                      updatable="false" defaultValue="false">
                    <description>标记应用是否被逻辑删除，true 表示已移至回收站</description>
                </attr>

                <attr name="title" index="20" displayName="标题" mandatory="true" domain="string" queryable="true"
                      sortable="true" allowFilterOp="eq,like,startsWith" orm:insertable="true" orm:updatable="true"
                      insertable="true" updatable="true">
                    <description>应用的名称，用于界面展示</description>
                    <constraint minLength="1" maxLength="200"/>
                </attr>
                <attr name="code" index="21" displayName="编码" mandatory="true" domain="string" queryable="true"
                      sortable="true" allowFilterOp="eq,like" orm:insertable="true" orm:updatable="false"
                      insertable="false" updatable="false" codeRule="{@uuid}">
                    <description>应用的全局唯一编码，由系统自动生成，不可变更</description>
                    <constraint minLength="32" maxLength="32"/>
                </attr>
                <attr name="description" index="22" displayName="描述" domain="text" queryable="true" sortable="false"
                      allowFilterOp="eq,like" orm:insertable="true" orm:updatable="true" insertable="true"
                      updatable="true">
                    <description>应用的详细说明或用途</description>
                    <constraint maxLength="2000"/>
                </attr>
                <attr name="activeVersion" index="23" displayName="已激活版本" domain="entityRef" mandatory="false"
                      queryable="true" sortable="true" allowFilterOp="eq,in" orm:insertable="true" orm:updatable="true"
                      insertable="true" updatable="true" ref:target="AppVersionEntity" ref:type="one-to-one">
                    <description>当前应用运行时使用的版本，同一时刻只有一个版本可被激活</description>
                </attr>
                <attr name="versions" index="24" displayName="版本列表" domain="entityRef" virtual="false"
                      queryable="false" sortable="false" ref:target="AppVersionEntity" ref:type="one-to-many"
                      ref:targetAttr="app" ref:cascadeDelete="true">
                    <description>应用的所有版本，包括草稿和已发布版本</description>
                </attr>
            </attrs>
        </entity>
        <entity name="AppVersionEntity" displayName="应用版本" db:estimatedRowCount="20000" orm:createrProp="createdBy"
                orm:createTimeProp="createdAt" orm:updaterProp="updatedBy" orm:updateTimeProp="updatedAt">
            <description>应用的某个特定版本，包含该版本的完整定义（需求、生成的代码等）</description>
            <orm:unique-keys>
                <key name="uk_app_name">app,name</key>
            </orm:unique-keys>
            <attrs>
                <attr name="id" index="1" displayName="ID" mandatory="true" domain="uuid" queryable="true"
                      sortable="false" allowFilterOp="eq,in" orm:primary="true" orm:insertable="true"
                      orm:updatable="false" published="false" insertable="false" updatable="false">
                </attr>
                <attr name="createdBy" index="2" displayName="创建者" domain="userFlag" queryable="true" sortable="true"
                      allowFilterOp="eq,in" orm:insertable="true" orm:updatable="false" insertable="false"
                      updatable="false">
                </attr>
                <attr name="updatedBy" index="3" displayName="更新者" domain="userFlag" queryable="true" sortable="true"
                      allowFilterOp="eq,in" orm:insertable="true" orm:updatable="true" insertable="false"
                      updatable="false">
                </attr>
                <attr name="createdAt" index="4" displayName="创建时间" domain="datetime" queryable="true"
                      sortable="true"
                      allowFilterOp="eq,dateBetween,dateTimeBetween" orm:insertable="true" orm:updatable="false"
                      insertable="false" updatable="false" datePattern="yyyy-MM-dd HH:mm:ss">
                </attr>
                <attr name="updatedAt" index="5" displayName="更新时间" domain="datetime" queryable="true"
                      sortable="true"
                      allowFilterOp="eq,dateBetween,dateTimeBetween" orm:insertable="true" orm:updatable="true"
                      insertable="false" updatable="false" datePattern="yyyy-MM-dd HH:mm:ss">
                </attr>

                <attr name="app" index="20" displayName="所属应用" mandatory="true" domain="entityRef" queryable="true"
                      sortable="true" allowFilterOp="eq,in" orm:insertable="true" orm:updatable="true"
                      insertable="true" updatable="true" ref:target="AppEntity" ref:type="one-to-one">
                    <description>该版本所属的应用</description>
                </attr>
                <attr name="name" index="21" displayName="版本号" mandatory="true" domain="string" queryable="true"
                      sortable="true" allowFilterOp="eq,like" orm:insertable="true" orm:updatable="true"
                      insertable="true" updatable="true">
                    <description>语义化版本号，格式为 x.y.z，每段最多 3 位数字，在所属应用内唯一</description>
                    <constraint pattern="^\d{1,3}\.\d{1,3}\.\d{1,3}$" maxLength="11"/>
                </attr>
                <attr name="status" index="22" displayName="版本状态" mandatory="true" domain="string"
                      dict="app-version/status" queryable="true" sortable="true" allowFilterOp="eq,in"
                      orm:insertable="true" orm:updatable="true" insertable="false" updatable="false">
                    <description>版本当前状态：草稿或已发布</description>
                </attr>
                <attr name="derivedFrom" index="23" displayName="衍生来源" domain="entityRef" mandatory="false"
                      queryable="true" sortable="true" allowFilterOp="eq,in" orm:insertable="true" orm:updatable="false"
                      insertable="false" updatable="false" ref:target="AppVersionEntity" ref:type="one-to-one">
                    <description>该版本所基于的已发布版本，用于追踪版本演进历史</description>
                </attr>
            </attrs>
        </entity>
    </entities>
    <actions/>
</model-design>
