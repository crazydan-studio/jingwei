<c:script xmlns:c="c"><![CDATA[
    import io.crazydan.jingwei.app.AppConstants;

    const xdefs = [
        AppConstants.XDSL_SCHEMA_APP_PACKAGE_RESOURCE,
        AppConstants.XDSL_SCHEMA_APP_RELEASING_MANIFEST,
        AppConstants.XDSL_SCHEMA_APP_INSTALLATION_MANIFEST,
    ];

    xdefs.forEach((xdef) => {
        codeGenerator
            // 设置生成代码的存放位置，其相对于当前 Maven 工程的根目录
            .withTargetDir('../service')
            .renderModel(xdef, '/nop/templates/xdsl', '/', $scope);
    });
]]></c:script>
