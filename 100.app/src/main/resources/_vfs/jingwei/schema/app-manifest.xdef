<!-- [应用安装清单]
> 记录应用安装后的资源清单。
>
-->
<manifest xmlns:x="/nop/schema/xdsl.xdef" xmlns:xdef="/nop/schema/xdef.xdef"
          x:schema="/nop/schema/xdef.xdef"
          xdef:bean-package="io.crazydan.jingwei.app.model.manifest"
          xdef:name="AppInstallationManifest"
          code="!string" version="!string"
          installedAt="!datetime"
>

    <!-- [模块资源]
    -->
    <module-resources xdef:body-type="list" xdef:key-attr="path">
        <resource xdef:name="AppInstallationResource"
                  path="!string"
        />
    </module-resources>

    <!-- [UI 资源]
    -->
    <ui-resources xdef:body-type="list" xdef:key-attr="path">
        <resource xdef:name="AppInstallationResource"
                  path="!string"
        />
    </ui-resources>
</manifest>
