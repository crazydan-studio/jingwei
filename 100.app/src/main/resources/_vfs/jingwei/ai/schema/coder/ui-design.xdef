<?xml version="1.0" encoding="UTF-8" ?>

<ui-design xmlns:x="/nop/schema/xdsl.xdef" xmlns:xdef="/nop/schema/xdef.xdef"
           x:schema="/nop/schema/xdef.xdef"
>

    <pages xdef:body-type="list" xdef:key-attr="name">
        <page name="!kebab-case" displayName="!string">
            <body>page-component-code</body>

            <demo-data xdef:body-type="list" xdef:key-attr="name">
                <api name="!kebab-case">json</api>
            </demo-data>
        </page>
    </pages>
</ui-design>
