<!-- [应用安装包清单]
> 记录应用安装包中的资源清单。
>
-->
<manifest xmlns:x="/nop/schema/xdsl.xdef" xmlns:xdef="/nop/schema/xdef.xdef"
          x:schema="/nop/schema/xdef.xdef"
          xdef:bean-package="io.crazydan.jingwei.app.model.manifest"
          xdef:name="AppInstallation_Manifest"
          code="!string" version="!string"
>

    <!-- [模型资源]
    -->
    <modelResources xdef:name="AppInstallation_ModelResources"
                    xdef:body-type="list" xdef:key-attr="path"
                    xdef:bean-body-prop="body"
    >
        <resource xdef:ref="resource.xdef"
                  path="!file-path"
        />
    </modelResources>

    <!-- [ORM 资源]
    -->
    <ormResources xdef:name="AppInstallation_OrmResources"
                  xdef:body-type="list" xdef:key-attr="path"
                  xdef:bean-body-prop="body"
    >
        <resource xdef:ref="resource.xdef"
                  path="!file-path"
        />
    </ormResources>

    <!-- [页面资源]
    -->
    <pageResources xdef:name="AppInstallation_PageResources"
                   xdef:body-type="list" xdef:key-attr="path"
                   xdef:bean-body-prop="body"
    >
        <resource xdef:ref="resource.xdef"
                  path="!file-path"
        />
    </pageResources>
</manifest>
