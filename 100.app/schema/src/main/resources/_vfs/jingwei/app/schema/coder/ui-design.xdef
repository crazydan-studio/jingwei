<?xml version="1.0" encoding="UTF-8" ?>

<ui-design xmlns:x="/nop/schema/xdsl.xdef" xmlns:xdef="/nop/schema/xdef.xdef"
           x:schema="/nop/schema/xdef.xdef"
>

    <page title="!string">page-code</page>

    <components xdef:body-type="list" xdef:key-attr="name">
        <component name="!camel-case">component-code</component>
    </components>

    <demo-data xdef:body-type="list" xdef:key-attr="name">
        <api name="!api-name">json</api>
    </demo-data>
</ui-design>
