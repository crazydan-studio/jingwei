<!-- [应用发布包清单]
> 记录应用发布包中的资源清单。
>
-->
<manifest xmlns:x="/nop/schema/xdsl.xdef" xmlns:xdef="/nop/schema/xdef.xdef"
          x:schema="/nop/schema/xdef.xdef"
          xdef:bean-package="io.crazydan.jingwei.app.model"
          xdef:name="AppReleasing_Manifest"
          bizDomain="!ns-name" code="!string"
          name="!string" version="!string"
          icon="file-path"
>

    <description>!string</description>

    <!-- [应用的作者信息]
    > 作者可以是个人，也可以是组织。
    -->
    <author xdef:name="AppReleasing_Author"
            name="!string" email="email" url="url"
    />

    <!-- [应用的需求设计资源]
    > 应用功能、模型、UI 设计的需求说明文档。应用功能需求必须指定，而模型和 UI 需求必须至少指定一项。
    -->
    <requirementResource xdef:name="AppReleasing_RequirementResource">
        <appDesign xdef:ref="resource.xdef"/>

        <modelDesign xdef:ref="resource.xdef"/>
        <uiDesign xdef:ref="resource.xdef"/>
    </requirementResource>

    <!-- [应用的源码资源]
    > 用于生成应用代码的 DSL 资源。根据需求设计资源确定模型和 UI 设计资源是否必须包含。
    -->
    <coderResource xdef:name="AppReleasing_CoderResource">
        <modelDesign xdef:ref="resource.xdef"/>
        <uiDesign xdef:ref="resource.xdef"/>
    </coderResource>

    <!-- [应用的构建产物]
    > 将被释放到应用安装目录中的构建产物资源。若未指定，则在安装时动态构建。
    -->
    <artifactResource xdef:name="AppReleasing_ArtifactResource">
        <model xdef:ref="resource.xdef"
               xdef:unique-attr="path"
               path="!file-path"
        />

        <orm xdef:ref="resource.xdef"
             xdef:unique-attr="path"
             path="!file-path"
        />

        <page xdef:ref="resource.xdef"
              xdef:unique-attr="path"
              path="!file-path"
        />
    </artifactResource>
</manifest>
