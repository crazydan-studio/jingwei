<!-- [应用安装后清单]
> 记录应用安装后的资源清单，用于校验已安装应用的完整性。
>
-->
<manifest xmlns:x="/nop/schema/xdsl.xdef" xmlns:xdef="/nop/schema/xdef.xdef"
          x:schema="/nop/schema/xdef.xdef"
          xdef:bean-package="io.crazydan.jingwei.app.model.manifest"
          xdef:name="AppPostInstallation_Manifest"
          code="!string" version="!string"
          installedAt="!datetime"
>

    <!-- [模块资源]
    -->
    <moduleResources xdef:name="AppPostInstallation_ModuleResource"
                     xdef:body-type="list" xdef:key-attr="path"
                     xdef:bean-body-prop="body"
    >
        <resource xdef:ref="AppPostInstallation_Resource"
                  path="!file-path"
        />
    </moduleResources>

    <!-- [UI 资源]
    -->
    <uiResources xdef:name="AppPostInstallation_UiResources"
                 xdef:body-type="list" xdef:key-attr="path"
                 xdef:bean-body-prop="body"
    >
        <resource xdef:ref="AppPostInstallation_Resource"
                  path="!file-path"
        />
    </uiResources>

    <xdef:define xdef:name="AppPostInstallation_Resource"
                 path="!file-path"
    />
</manifest>
