<!-- [应用本地仓库清单]
> 记录本地应用仓库的应用列表及其状态。
>
-->
<manifest xmlns:x="/nop/schema/xdsl.xdef" xmlns:xdef="/nop/schema/xdef.xdef"
          x:schema="/nop/schema/xdef.xdef"
          xdef:bean-package="io.crazydan.jingwei.app.model"
          xdef:name="AppLocalStore_Manifest"
>

    <portalApp xdef:ref="AppLocalStore_App"/>

    <enabledApps xdef:name="AppLocalStore_EnabledApps"
                 xdef:body-type="list" xdef:key-attr="code"
                 xdef:bean-body-prop="children" xdef:bean-child-name="child"
    >
        <app xdef:ref="AppLocalStore_App"
             code="!string"
        />
    </enabledApps>

    <xdef:define xdef:name="AppLocalStore_App"
                 code="!string"
    />
</manifest>
