<c:script xmlns:c="c"><![CDATA[
  codeGenerator
    // 设置生成代码的存放位置，其相对于当前工程的根目录
    .withTargetDir('../../600.store')
    .renderModel(
      // 设置 ORM 模型定义文件，其位置相对于该 xgen 脚本所在的目录
      '../store.orm.xlsx',
      // 代码模板资源的 classpath 位置
      '/jingwei/templates/store',
      // 以下参数保持不变
      '/', $scope
    );
]]></c:script>
