<!-- [组件的内部定义]
> 用于生成实际的模型对象 `XuiComponent`。
>
> 由于 `<template/>` 中的组件树需要根据在组件上的属性和状态动态生成，
> 且生成的控制逻辑采用 Xpl 内置标签，故而，需要让 `<template/>` 节点对应为
> `IXNodeGenerator` 类型。但该类型节点不能定义明确的嵌套结构，
> 所以，在实现和开发层面对其做区别定义。
-->
<component xmlns:x="/nop/schema/xdsl.xdef" xmlns:xdef="xdef"
           x:schema="/nop/schema/xdef.xdef"
           x:extends="super"
>

    <template xdef:value="xpl-node" x:override="replace"/>
</component>
