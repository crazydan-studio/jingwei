<page xmlns:x="/nop/schema/xdsl.xdef"
      x:schema="/jingwei/ui/schema/page.xdef"
>
    <import as="Button" from="/jingwei/ui/component/button.xui"/>

    <template>
        <choose xid="choose-person-init-or-not">
            <when test="${$data.me.notExist}">
                <layout>
                    <linear><![CDATA[
                        v>[btn-add-personal-information]<^
                    ]]></linear>
                </layout>

                <Button xid="btn-add-personal-information">
                    <dispatch msg="Route_to_Person_Edit_Page"
                              events="click" data="${$data.me}"
                    />

                    <Text xid="label"><![CDATA[
                        Add Personal Information
                    ]]></Text>
                </Button>
            </when>
            <otherwise>
                <layout>
                    <linear><![CDATA[
                        v>{
                            <[btn-personal-management]>
                            <[btn-app-settings]>
                        }<^
                    ]]></linear>
                </layout>

                <Button xid="btn-personal-management">
                    <dispatch msg="Route_to_Person_Management_Page"
                              events="click" data="${$data.me}"
                    />

                    <Text xid="label"><![CDATA[
                        Personal Management
                    ]]></Text>
                </Button>
                <Button xid="btn-app-settings">
                    <dispatch msg="Route_to_App_Settings_Page"
                              events="click" data="${$data.settings}"
                    />

                    <Text xid="label"><![CDATA[
                        App Settings
                    ]]></Text>
                </Button>
            </otherwise>
        </choose>
    </template>

    <messages>
        <message name="Route_to_Person_Edit_Page">
            <route to="/person/edit" data="${data}"/>
        </message>
        <message name="Route_to_Person_Management_Page">
            <route to="/person/management" data="${data}"/>
        </message>

        <message name="Route_to_App_Settings_Page">
            <route to="/app/settings" data="${data}"/>
        </message>
    </messages>
</page>
