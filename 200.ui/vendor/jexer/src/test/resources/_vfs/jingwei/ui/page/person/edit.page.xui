<page xmlns:x="/nop/schema/xdsl.xdef" xmlns:xui="xui"
      x:schema="/jingwei/ui/schema/page.xdef"
>
    <import as="Input" from="/jingwei/ui/component/form/input.xui"/>
    <import as="ComboBox" from="/jingwei/ui/component/form/combo-box.xui"/>
    <import as="DatePicker" from="/jingwei/ui/component/form/date-picker.xui"/>

    <template>
        <layout>
            <linear><![CDATA[
                v>{
                    <[input-first-name]>
                    <[input-family-name]>
                    <[combobox-gender]>
                    <[datepicker-birthdate]>
                    <[input-id-card-number]>
                }<^
            ]]></linear>
        </layout>

        <Input xui:name="input-first-name"
               value="${$data.firstName}"
        >
            <Text xui:name="label" xui:slot="label"><![CDATA[
                First Name
            ]]></Text>
        </Input>

        <Input xui:name="input-family-name"
               value="${$data.familyName}"
               label="Family Name"
        >
            <Text xui:name="label" xui:slot="label"><![CDATA[
                First Name
            ]]></Text>
        </Input>

        <ComboBox xui:name="combobox-gender"
                  value="${$data.gender}"
        >
            <Text xui:name="label" xui:slot="label"><![CDATA[
                Gender
            ]]></Text>
        </ComboBox>

        <DatePicker xui:name="datepicker-birthdate"
                    value="${$data.birthdate}"
        >
            <Text xui:name="label" xui:slot="label"><![CDATA[
                Birth Date
            ]]></Text>
        </DatePicker>

        <Input xui:name="input-id-card-number"
               value="${$data.idCardNumber}"
        >
            <Text xui:name="label" xui:slot="label"><![CDATA[
                ID Card Number
            ]]></Text>
        </Input>
    </template>
</page>
