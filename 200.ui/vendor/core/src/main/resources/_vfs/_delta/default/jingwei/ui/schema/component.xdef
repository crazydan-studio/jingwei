<!-- [动态组件]
> 用于在本地优先应用中根据数据动态生成组件树，类似于在 Web 前端中的 Vue 等响应式框架所做的事情。
>
> 与组件相关的数据变更将实时生成相应的组件树，在与变更前的组件树做差量比较后，可对 UI 进行差量更新。
-->
<component xmlns:x="/nop/schema/xdsl.xdef" xmlns:xdef="xdef"
           x:schema="/nop/schema/xdef.xdef"
           x:extends="super"
           xdef:name="DynamicXuiComponent" xdef:bean-package="io.crazydan.jingwei.ui.schema.component"
>

    <!-- [支持 Xpl 控制标签的组件树模板]
    > - `<if/>`、`<for/>` 等控制标签将直接映射到相应的 Xpl 内置标签上，并在运行期执行，从而可动态获取组件树；
    > - 该节点对应的模型属性为 `IXNodeGenerator` 类型；
    -->
    <template xdef:value="xpl-node" x:override="replace"/>
</component>
