<c:script xmlns:c="c"><![CDATA[
    import java.io.File;
    import io.crazydan.duzhou.framework.commons.StringHelper;
    import io.crazydan.duzhou.framework.commons.ShellHelper;
    import io.crazydan.duzhou.framework.commons.FileHelper;
    import io.crazydan.duzhou.framework.commons.PnpmRunner;
    import io.crazydan.jingwei.agent.AgentServer;

    const rootDir = FileHelper.getMavenProjectRoot(codeGenerator);
    const webSrcDir = new File(rootDir, 'web');
    const webDistDir = new File(webSrcDir, 'dist');
    const webTargetDir = new File(rootDir, 'target/classes/exec');
    const webTargetDistDir = new File(webTargetDir, 'lib');

    const artifactFile = new File(webTargetDistDir, 'main.mjs');
    if (artifactFile.exists()) {
        logInfo("jingwei.app.build.artifact.exist: {} already exists in {}, ignore this building",
                artifactFile.getName(), webTargetDir
        );
        return;
    }

    const srcPnpm = new PnpmRunner(webSrcDir);
    srcPnpm.runScript('build')
            // 直接将构建产物复制到 target 中，避免污染源码
            .copyDistTo(webTargetDistDir);

    // <<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<
    // 保留依赖包信息
    const pnpmLockSrcFile = new File(webSrcDir, 'pnpm-lock.yaml');
    const packageSrcFile = new File(webSrcDir, 'package.json');
    FileHelper.copyFiles(webTargetDir, pnpmLockSrcFile, packageSrcFile);

    // 移除构建相关的包
    const pkgJsonFile = new File(webTargetDir, packageSrcFile.getName());
    const pkgJson = FileHelper.readJson(pkgJsonFile, StringHelper.ENCODING_UTF8);

    const devDependencies = pkgJson['devDependencies'].keySet();
    const targetPnpm = new PnpmRunner(webTargetDir);
    targetPnpm.uninstallPackages(devDependencies, true);

    // 修改执行入口
    pkgJson.remove('devDependencies');
    pkgJson['scripts'] = {
        start: 'node ' + webTargetDistDir.getName() + '/' + artifactFile.getName()
    };
    FileHelper.writeJson(pkgJsonFile, pkgJson, StringHelper.ENCODING_UTF8);

    // 记录有效文件
    const manifestFile = new File(webTargetDir, AgentRunner.FILE_MANIFEST);
    const paths = FileHelper.findFilePaths(webTargetDir,"**/*", true, true);
    FileHelper.writeJson(manifestFile, paths, StringHelper.ENCODING_UTF8);
]]></c:script>
