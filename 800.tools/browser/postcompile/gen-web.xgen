<c:script xmlns:c="c"><![CDATA[
    import java.io.File;
    import io.crazydan.duzhou.framework.commons.StringHelper;
    import io.crazydan.duzhou.framework.commons.ShellHelper;
    import io.crazydan.duzhou.framework.commons.FileHelper;

    const rootDir = FileHelper.getMavenProjectRoot(codeGenerator);
    const webSrcDir = new File(rootDir, 'web');
    const webDistDir = new File(webSrcDir, 'dist');
    const webTargetDir = new File(rootDir, 'target/classes/node');
    const webTargetDistDir = new File(webTargetDir, 'lib');

    const artifactFile = new File(webTargetDistDir, 'main.mjs');
    if (artifactFile.exists()) {
        logInfo("jingwei.app.build.artifact.exist: {} already exists in {}, ignore this building",
                artifactFile.getName(), webTargetDir
        );
        return;
    }

    ShellHelper.runExecutable('pnpm', ['install'], webSrcDir, true);
    ShellHelper.runExecutable('pnpm', ['run', 'build'], webSrcDir, true);

    // 直接将构建产物复制到 target 中，避免污染源码
    FileHelper.deleteDir(webTargetDistDir);
    FileHelper.copyWithFilter(webDistDir, webTargetDistDir, null);

    // 保留依赖包信息
    const pnpmLockSrcFile = new File(webSrcDir, 'pnpm-lock.yaml');
    const packageSrcFile = new File(webSrcDir, 'package.json');
    const pnpmLockTargetFile = new File(webTargetDir, pnpmLockSrcFile.getName());
    const packageTargetFile = new File(webTargetDir, packageSrcFile.getName());
    FileHelper.copyFile(pnpmLockSrcFile, pnpmLockTargetFile);
    FileHelper.copyFile(packageSrcFile, packageTargetFile);
    // 移除构建相关的包
    const pkgJson = FileHelper.readJson(packageTargetFile, StringHelper.ENCODING_UTF8);
    const devDependencies = pkgJson['devDependencies'].keySet();
    if (!devDependencies.isEmpty()) {
        const deps = devDependencies.join(' ');
        ShellHelper.runExecutable('pnpm', ['remove', deps], webTargetDir, true);
    }
    // 修改执行入口
    pkgJson.remove('devDependencies');
    pkgJson['scripts'] = {start: 'node lib/main.mjs'};
    FileHelper.writeJson(packageTargetFile, pkgJson, StringHelper.ENCODING_UTF8);
    //
    const nodeModulesTargetDir = new File(webTargetDir, 'node_modules');
    FileHelper.deleteDir(nodeModulesTargetDir);
]]></c:script>
